{
  "name": "@chrissgon/agent-ready-kit",
  "version": "0.1.0",
  "description": "Make a small site readable by AI agents from one data file: llms.txt, schema.org JSON-LD and a read-only MCP server.",
  "keywords": [
    "llms.txt",
    "json-ld",
    "schema.org",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "seo",
    "static-site"
  ],
  "homepage": "https://github.com/chrissgon/agent-ready-kit#readme",
  "bugs": {
    "url": "https://github.com/chrissgon/agent-ready-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrissgon/agent-ready-kit.git"
  },
  "license": "MIT",
  "author": "Christopher Gonçalves (https://chrissgon.dev)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-ready": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./llms": {
      "types": "./dist/llms.d.ts",
      "default": "./dist/llms.js"
    },
    "./jsonld": {
      "types": "./dist/jsonld.d.ts",
      "default": "./dist/jsonld.js"
    },
    "./mcp": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "bash scripts/pack-smoke.sh",
    "prepack": "npm run build",
    "changelog": "changelogen --noAuthors --no-output",
    "release:prepare": "changelogen --bump --noAuthors --output CHANGELOG.md",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@modelcontextprotocol/inspector": "2.8.0",
    "@types/node": "26.6.3",
    "changelogen": "0.6.2",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
